---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
    {% unless page.url contains '/assets/' or page.url contains '/404.html' or page.url contains '/robots.txt' or page.url contains '/sitemap.xml' %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
  </url>
    {% endunless %}
  {% endfor %}
</urlset>
